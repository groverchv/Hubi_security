# Hubzy Backend Environment Variables
#
# MongoDB — elige UN camino:
#  · Local dev:          mongodb://localhost:27017
#  · MongoDB Atlas:      mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/hubzy_db?retryWrites=true&w=majority
#  · Contenedor (compose --profile local-db): mongodb://hubzy:PASS@mongodb:27017/hubzy_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hubzy_db
# Credenciales de Mongo — solo si usas el contenedor local-db (no aplica a Atlas)
MONGO_ROOT_USER=hubzy
MONGO_ROOT_PASSWORD=
# Puerto HTTP publicado por nginx (default 80)
# HTTP_PORT=80

# Qdrant
QDRANT_URL=
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# IA
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
# VirusTotal (opcional). Solo se consulta el hash del archivo; no se sube el PDF.
VIRUSTOTAL_API_KEY=
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SCHOOL_PRICE_ID=

# Auth — OBLIGATORIO cambiar en producción (openssl rand -hex 32)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Entorno y seguridad
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
RATE_LIMIT_ENABLED=true
# Emails admin (separados por coma) — acceso a /ai/training-dataset
ADMIN_EMAILS=
# Backend de storage del rate limiter (opcional, default memory://).
# Obligatorio si corren múltiples workers/réplicas:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# Recursos de crisis (JSON array, opcional)
# CRISIS_RESOURCES_JSON=[{"name":"Línea de ayuda","phone":"800-XX-XXXX","type":"hotline"}]

# Email transaccional (verificación + reset de contraseña)
# Sin SMTP_HOST los emails se imprimen en el log del backend (modo dev)
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@hubzy.app
SMTP_USE_TLS=true

# Modelos pretrained locales (requieren `pip install transformers torch` ~2GB)
# Desactivados por defecto — las heurísticas cubren el caso común.
# SAFETY_MODEL_ENABLED=true     # clasificador de contenido inseguro para menores
# SAFETY_MODEL_NAME=unitary/toxic-bert
# CRISIS_MODEL_ENABLED=true     # clasificador de emociones (señales indirectas de riesgo)
# CRISIS_MODEL_NAME=finiteautomata/beto-emotion-analysis
